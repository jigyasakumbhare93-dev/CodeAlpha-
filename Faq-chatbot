# -----------------------------
# Load FAQ Data
# -----------------------------
@st.cache_data
def load_faqs():
    with open("faqs.json", "r", encoding="utf-8") as file:
        return json.load(file)


faqs = load_faqs()


# -----------------------------
# Text Preprocessing
# -----------------------------
def preprocess_text(text):
    text = text.lower()
    text = re.sub(r"[^a-zA-Z\s]", "", text)

    words = text.split()

    words = [
        lemmatizer.lemmatize(word)
        for word in words
        if word not in stop_words
    ]

    return " ".join(words)


# -----------------------------
# Prepare FAQ Questions
# -----------------------------
questions = [faq["question"] for faq in faqs]

processed_questions = [
    preprocess_text(question)
    for question in questions
]


# -----------------------------
# TF-IDF Model
# -----------------------------
vectorizer = TfidfVectorizer(
    ngram_range=(1, 2)
)

faq_vectors = vectorizer.fit_transform(processed_questions)


# -----------------------------
# Find Best Answer
# -----------------------------
def get_answer(user_question):

    processed_query = preprocess_text(user_question)

    if not processed_query.strip():
        return (
            "Please enter a question so I can help you. 😊",
            0,
            None
        )

    query_vector = vectorizer.transform([processed_query])

    similarities = cosine_similarity(
        query_vector,
        faq_vectors
    )[0]

    best_index = similarities.argmax()
    best_score = similarities[best_index]

    # Confidence threshold
    if best_score < 0.20:
        return (
            "I'm sorry, I couldn't find a suitable answer to that question. "
            "Please try asking about orders, payments, shipping, returns, "
            "accounts, or customer support.",
            best_score,
            None
        )

    return (
        faqs[best_index]["answer"],
        best_score,
        faqs[best_index]["question"]
    )


