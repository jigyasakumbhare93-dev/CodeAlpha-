import os
import pickle
import numpy as np
from music21 import converter, note, chord

DATASET = "dataset/midi"
SEQUENCE_LENGTH = 50

notes = []

for file in os.listdir(DATASET):
    if file.endswith(".mid") or file.endswith(".midi"):
        try:
            midi = converter.parse(os.path.join(DATASET, file))

            for element in midi.flatten().notes:
                if isinstance(element, note.Note):
                    notes.append(str(element.pitch))

                elif isinstance(element, chord.Chord):
                    notes.append(".".join(str(n) for n in element.normalOrder))

        except Exception as e:
            print("Error:", e)

print("Total notes:", len(notes))

if len(notes) <= SEQUENCE_LENGTH:
    raise ValueError("Add more MIDI files to dataset/midi")

unique_notes = sorted(set(notes))
note_to_int = {n: i for i, n in enumerate(unique_notes)}

X = []
y = []

for i in range(len(notes) - SEQUENCE_LENGTH):
    sequence = notes[i:i + SEQUENCE_LENGTH]
    target = notes[i + SEQUENCE_LENGTH]

    X.append([note_to_int[n] for n in sequence])
    y.append(note_to_int[target])

X = np.array(X)
y = np.array(y)

os.makedirs("model", exist_ok=True)

np.save("model/X.npy", X)
np.save("model/y.npy", y)

with open("model/notes.pkl", "wb") as f:
    pickle.dump(unique_notes, f)

print("Preprocessing completed!")
print("Training samples:", len(X))
