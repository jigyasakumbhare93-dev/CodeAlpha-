model = load_model("model/music_model.h5")

with open("model/notes.pkl", "rb") as f:
    notes = pickle.load(f)

vocab_size = len(notes)

sequence_length = 50

pattern = [random.randint(0, vocab_size - 1)
           for _ in range(sequence_length)]

generated = []

for i in range(100):

    input_data = np.array(pattern)
    input_data = input_data.reshape(1, sequence_length, 1)
    input_data = input_data / float(vocab_size)

    prediction = model.predict(input_data, verbose=0)

    index = np.argmax(prediction)

    generated.append(notes[index])

    pattern.append(index)
    pattern = pattern[1:]

output = stream.Stream()

for item in generated:

    if "." in item:
        numbers = item.split(".")

        notes_in_chord = [
            note.Note(int(n)) for n in numbers
        ]

        new_chord = chord.Chord(notes_in_chord)
        output.append(new_chord)

    else:
        new_note = note.Note(item)
        output.append(new_note)

output.write(
    "midi",
    fp="generated_music.mid"
)

